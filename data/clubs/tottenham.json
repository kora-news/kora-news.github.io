  "unresolved": [
    "الأكثر تتويجا بكل الألقاب الرسمية، بما فيها الدرع، غير محسوم؛ رقم بيريمان ستة يخص البطولات الكبرى فقط.",
    "بعض الكؤوس الخيرية الإقليمية القديمة في صفحة النادي تحتاج إلى تصنيف قبل وصف سجل الألقاب بأنه كامل."
  ],
  "history": {
    "textAr": "بدأ توتنهام عام 1882 باسم هوتسبير، ثم حمل اسمه الحالي عام 1884. وفاز بكأس الاتحاد الإنجليزي عام 1901 وهو خارج دوري كرة القدم، وحقق ثنائية الدوري والكأس عام 1961. وفي 1963 أضاف كأس الكؤوس الأوروبية، أحد أبرز إنجازات جيل المدرب بيل نيكلسون.",
    "sourceIds": [
