  "unresolved": [
    "تدقيق ألقاب لندن وكينت التاريخية قبل ضمها إلى ألقاب الفريق الأول.",
    "صدارة الأكثر تتويجا مع النادي وفق جميع البطولات الرسمية بما فيها الدروع والتعادلات لم تثبت بعد.",
    "يعرض عنوان التاريخ العام 15 دوريًا مقابل 14 موسم فوز مسردًا في سجل الألقاب؛ اعتمد الجدول المواسم المفصلة، مع إبقاء اختلاف الموقع الأصلي ظاهرًا."
  ],
  "history": {
    "textAr": "تأسس أرسنال سنة 1886 على يد عمال مصنع الأسلحة في وولويتش باسم دايل سكوير، ثم حمل اسم رويال أرسنال ووولويتش أرسنال. انضم إلى دوري كرة القدم عام 1893، وانتقل إلى هايبري في شمال لندن عام 1913.\nمن أبرز محطاته أول كأس إنجلترا عام 1930، وثنائية الدوري والكأس في 1971 و 1998 و 2002، وموسم الدوري بلا هزيمة في 2003/04. عاد إلى الفوز بالدوري في 2025/26 بعد انتظار 22 عاما.",
    "sourceIds": [
      "history",
      "records",
      "league-2026"
    ]
  },
